########################################
# BINGO SAAS - VARIABLES DE ENTORNO
# Copiar este archivo como ".env" y
# completar con los datos reales.
# NUNCA subir el archivo ".env" a un
# repositorio publico.
########################################

APP_NAME="Bingo SaaS"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/bingo-saas/public
APP_TIMEZONE=America/Bogota

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bingo_saas
DB_USER=root
DB_PASS=

SESSION_NAME=bingo_saas_session
SESSION_LIFETIME=7200

HASH_COST=12
